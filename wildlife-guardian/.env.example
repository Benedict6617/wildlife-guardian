# Copy this file to .env and adjust for your environment.
# The backend also works with zero configuration (SQLite + simulated SMS).

# --- Backend -----------------------------------------------------------

# SQLite (default, zero-config):
DATABASE_URL=sqlite:///./wildlife_guardian.db
# PostgreSQL (recommended for production / multi-ranger concurrent writes):
# DATABASE_URL=postgresql+psycopg2://wildlife:changeme@localhost:5432/wildlife_guardian

ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://127.0.0.1:5500

# SMS gateway. "simulated" logs sends and requires no credentials.
# Set to "africas_talking" or "twilio" once you implement the corresponding
# SMSGateway subclass in app/services/sms_gateway.py and add credentials below.
SMS_PROVIDER=simulated

# Africa's Talking (if SMS_PROVIDER=africas_talking)
# AFRICASTALKING_USERNAME=
# AFRICASTALKING_API_KEY=
# AFRICASTALKING_SENDER_ID=

# Twilio (if SMS_PROVIDER=twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# --- Frontend ------------------------------------------------------------
# Set this in frontend/index.html (window.WILDLIFE_GUARDIAN_API_BASE) or via
# your static host's env injection when deploying, e.g.:
# WILDLIFE_GUARDIAN_API_BASE=https://api.yourconservancy.org/api/v1
